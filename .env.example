# Optional persistent server configuration. UI-entered keys are session-only.
# Copy to .env (ignored by Git), fill only providers you use.
# Rates are USD per million tokens; obtain current rates from your provider.
# All four nonempty provider values are needed to create an environment profile.
FORGE_OPENROUTER_API_KEY=
FORGE_OPENROUTER_MODEL=
FORGE_OPENROUTER_INPUT_RATE=
FORGE_OPENROUTER_OUTPUT_RATE=

FORGE_OPENAI_API_KEY=
FORGE_OPENAI_MODEL=
FORGE_OPENAI_INPUT_RATE=
FORGE_OPENAI_OUTPUT_RATE=

FORGE_ANTHROPIC_API_KEY=
FORGE_ANTHROPIC_MODEL=
FORGE_ANTHROPIC_INPUT_RATE=
FORGE_ANTHROPIC_OUTPUT_RATE=

FORGE_GEMINI_API_KEY=
FORGE_GEMINI_MODEL=
FORGE_GEMINI_INPUT_RATE=
FORGE_GEMINI_OUTPUT_RATE=

FORGE_PORT=4318
# FORGE_DATA_DIR=.forge/projects
