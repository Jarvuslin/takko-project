              "beforeSha256": "3ea385adf6211446124ee4a0f5c8b88fc905b0487854d555d5729602647e80cb",
              "source": "local TweenService = game:GetService(\"TweenService\")\nlocal part = script.Parent\nlocal clickDetector = part:WaitForChild(\"ClickDetector\")\nlocal clickSound = part:WaitForChild(\"Click\")\nlocal mesh = part:FindFirstChildOfClass(\"SpecialMesh\")\n\nlocal originalPosition = part.Position\nlocal originalTransparency = part.Transparency\nlocal originalMeshScale = mesh and mesh.Scale or Vector3.new(1, 1, 1)\n\nlocal isPopped = false\n\nlocal function pop()\n\tif isPopped then return end\n\tisPopped = true\n\tpart:SetAttribute(\"Popped\", true)\n\tclickDetector.MaxActivationDistance = 0\n\t\n\tclickSound:Play()\n\t\n\tlocal tweenInfo = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)\n\tif mesh then\n\t\tlocal targetScale = Vector3.new(originalMeshScale.X * 1.15, originalMeshScale.Y * 0.25, originalMeshScale.Z * 1.15)\n\t\tTweenService:Create(mesh, tweenInfo, { Scale = targetScale }):Play()\n\tend\n\t\n\tlocal partTween = TweenService:Create(part, tweenInfo, {\n\t\tTransparency = math.clamp(originalTransparency + 0.35, 0, 0.85),\n\t\tPosition = originalPosition - Vector3.new(0, 0.08, 0)\n\t})\n\tpartTween:Play()\n\tpartTween.Completed:Wait()\n\t\n\tlocal current = script.Parent\n\twhile current and current.Name ~= \"working bubble wrap\" and current.Parent do\n\t\tcurrent = current.Parent\n\tend\n\tif current then\n\t\tlocal popEvent = current:FindFirstChild(\"BubblePoppedEvent\")\n\t\tif popEvent and popEvent:IsA(\"BindableEvent\") then\n\t\t\tpopEvent:Fire(part)\n\t\tend\n\tend\nend\n\nlocal function reset()\n\tisPopped = false\n\tpart:SetAttribute(\"Popped\", false)\n\tclickDetector.MaxActivationDistance = 32\n\t\n\tlocal tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)\n\tif mesh then\n\t\tTweenService:Create(mesh, tweenInfo, { Scale = originalMeshScale }):Play()\n\tend\n\tTweenService:Create(part, tweenInfo, {\n\t\tTransparency = originalTransparency,\n\t\tPosition = originalPosition\n\t}):Play()\nend\n\nclickDetector.MouseClick:Connect(function()\n\tpop()\nend)\n\npart:GetAttributeChangedSignal(\"ResetBubble\"):Connect(function()\n\tif part:GetAttribute(\"ResetBubble\") == true then\n\t\treset()\n\t\tpart:SetAttribute(\"ResetBubble\", false)\n\tend\nend)\n",
              "reason": "Upgrade bubble script to provide responsive squash deflation animations, synchronized pop sound playback, debounce against repeated clicks, and notification to the sheet state manager upon pop completion."
            }
          ],
          "addSources": [
            {
              "name": "BubbleBreakManager",
              "parentIndex": 2,
              "securityTemplateIndex": 14,
              "className": "Script",
              "runContext": "Server",
              "disabled": false,
              "source": "local Players = game:GetService(\"Players\")\nlocal model = script.Parent\nlocal bubbleWrapModel = model:WaitForChild(\"bubble wrap\")\n\nlocal popEvent = Instance.new(\"BindableEvent\")\npopEvent.Name = \"BubblePoppedEvent\"\npopEvent.Parent = model\n\nlocal netFolder = Instance.new(\"Folder\")\nnetFolder.Name = \"BubbleBreakNetwork\"\nnetFolder.Parent = model\n\nlocal stateRemote = Instance.new(\"RemoteEvent\")\nstateRemote.Name = \"StateUpdate\"\nstateRemote.Parent = netFolder\n\nlocal resetRemote = Instance.new(\"RemoteEvent\")\nresetRemote.Name = \"ResetRequest\"\nresetRemote.Parent = netFolder\n\nlocal bubbleParts = {}\nfor _, child in ipairs(bubbleWrapModel:GetChildren()) do\n\tif child:IsA(\"BasePart\") and child:FindFirstChildOfClass(\"ClickDetector\") then\n\t\tchild.Anchored = true\n\t\ttable.insert(bubbleParts, child)\n\tend\nend\n\nlocal totalBubbles = #bubbleParts\nlocal poppedSet = {}\nlocal poppedCount = 0\n\nlocal function broadcastState()\n\tstateRemote:FireAllClients({\n\t\tpoppedCount = poppedCount,\n\t\ttotalCount = totalBubbles,\n\t\tisComplete = (poppedCount >= totalBubbles and totalBubbles > 0)\n\t})\nend\n\npopEvent.Event:Connect(function(part)\n\tif not poppedSet[part] then\n\t\tpoppedSet[part] = true\n\t\tpoppedCount = math.min(poppedCount + 1, totalBubbles)\n\t\tbroadcastState()\n\tend\nend)\n\nlocal function resetSheet()\n\tpoppedSet = {}\n\tpoppedCount = 0\n\tfor _, part in ipairs(bubbleParts) do\n\t\tpart:SetAttribute(\"ResetBubble\", true)\n\tend\n\tbroadcastState()\nend\n\nresetRemote.OnServerEvent:Connect(function(player)\n\tresetSheet()\nend)\n\nPlayers.PlayerAdded:Connect(function(player)\n\ttask.wait(0.5)\n\tstateRemote:FireClient(player, {\n\t\tpoppedCount = poppedCount,\n\t\ttotalCount = totalBubbles,\n\t\tisComplete = (poppedCount >= totalBubbles and totalBubbles > 0)\n\t})\nend)\n",
              "reason": "Server controller managing sheet bubble collection, validating single count increment per bubble, and broadcasting state and sheet resets to clients."
            },
            {
              "name": "BubbleBreakClient",
              "parentIndex": 2,
              "securityTemplateIndex": 14,
              "className": "Script",
              "runContext": "Client",
              "disabled": false,
              "source": "local Players = game:GetService(\"Players\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal player = Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\nlocal model = script.Parent\n\nlocal netFolder = model:WaitForChild(\"BubbleBreakNetwork\", 10)\nif not netFolder then return end\n\nlocal stateRemote = netFolder:WaitForChild(\"StateUpdate\")\nlocal resetRemote = netFolder:WaitForChild(\"ResetRequest\")\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"BubbleBreakGui\"\nscreenGui.ResetOnSpawn = false\nscreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling\nscreenGui.Parent = playerGui\n\nlocal topCard = Instance.new(\"Frame\")\ntopCard.Name = \"TopCard\"\ntopCard.Size = UDim2.new(0, 300, 0, 64)\ntopCard.Position = UDim2.new(0.5, -150, 0, 16)\ntopCard.BackgroundColor3 = Color3.fromRGB(20, 24, 32)\ntopCard.BackgroundTransparency = 0.2\ntopCard.BorderSizePixel = 0\ntopCard.Parent = screenGui\n\nlocal topCorner = Instance.new(\"UICorner\")\ntopCorner.CornerRadius = UDim.new(0, 12)\ntopCorner.Parent = topCard\n\nlocal topStroke = Instance.new(\"UIStroke\")\ntopStroke.Color = Color3.fromRGB(255, 255, 255)\ntopStroke.Transparency = 0.85\ntopStroke.Thickness = 1\ntopStroke.Parent = topCard\n\nlocal titleLabel = Instance.new(\"TextLabel\")\ntitleLabel.Name = \"TitleLabel\"\ntitleLabel.Size = UDim2.new(1, 0, 0, 22)\ntitleLabel.Position = UDim2.new(0, 0, 0, 6)\ntitleLabel.BackgroundTransparency = 1\ntitleLabel.Font = Enum.Font.GothamBold\ntitleLabel.Text = \"BUBBLE BREAK ASMR\"\ntitleLabel.TextColor3 = Color3.fromRGB(160, 210, 255)\ntitleLabel.TextSize = 13\ntitleLabel.Parent = topCard\n\nlocal counterLabel = Instance.new(\"TextLabel\")\ncounterLabel.Name = \"CounterLabel\"\ncounterLabel.Size = UDim2.new(1, 0, 0, 28)\ncounterLabel.Position = UDim2.new(0, 0, 0, 28)\ncounterLabel.BackgroundTransparency = 1\ncounterLabel.Font = Enum.Font.GothamBlack\ncounterLabel.Text = \"Popped: 0 / ...\"\ncounterLabel.TextColor3 = Color3.fromRGB(255, 255, 255)\ncounterLabel.TextSize = 18\ncounterLabel.Parent = topCard\n\nlocal resetBtn = Instance.new(\"TextButton\")\nresetBtn.Name = \"ResetButton\"\nresetBtn.Size = UDim2.new(0, 160, 0, 44)\nresetBtn.Position = UDim2.new(0.5, -80, 1, -64)\nresetBtn.BackgroundColor3 = Color3.fromRGB(45, 120, 235)\nresetBtn.Font = Enum.Font.GothamBold\nresetBtn.Text = \"Reset Sheet\"\nresetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)\nresetBtn.TextSize = 15\nresetBtn.AutoButtonColor = false\nresetBtn.Parent = screenGui\n\nlocal resetCorner = Instance.new(\"UICorner\")\nresetCorner.CornerRadius = UDim.new(0, 10)\nresetCorner.Parent = resetBtn\n\nlocal resetStroke = Instance.new(\"UIStroke\")\nresetStroke.Color = Color3.fromRGB(255, 255, 255)\nresetStroke.Transparency = 0.75\nresetStroke.Thickness = 1.2\nresetStroke.Parent = resetBtn\n\nlocal completionBanner = Instance.new(\"Frame\")\ncompletionBanner.Name = \"CompletionBanner\"\ncompletionBanner.Size = UDim2.new(0, 340, 0, 52)\ncompletionBanner.Position = UDim2.new(0.5, -170, 0.45, -26)\ncompletionBanner.BackgroundColor3 = Color3.fromRGB(35, 160, 90)\ncompletionBanner.BackgroundTransparency = 0.15\ncompletionBanner.Visible = false\ncompletionBanner.Parent = screenGui\n\nlocal bannerCorner = Instance.new(\"UICorner\")\nbannerCorner.CornerRadius = UDim.new(0, 12)\nbannerCorner.Parent = completionBanner\n\nlocal bannerLabel = Instance.new(\"TextLabel\")\nbannerLabel.Size = UDim2.new(1, 0, 1, 0)\nbannerLabel.BackgroundTransparency = 1\nbannerLabel.Font = Enum.Font.GothamBlack\nbannerLabel.Text = \"✨ Sheet Complete! Pure ASMR Bliss ✨\"\nbannerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)\nbannerLabel.TextSize = 15\nbannerLabel.Parent = completionBanner\n\nresetBtn.MouseEnter:Connect(function()\n\tTweenService:Create(resetBtn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(65, 140, 255)}):Play()\nend)\n\nresetBtn.MouseLeave:Connect(function()\n\tTweenService:Create(resetBtn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(45, 120, 235)}):Play()\nend)\n\nresetBtn.MouseButton1Down:Connect(function()\n\tTweenService:Create(resetBtn, TweenInfo.new(0.06), {Size = UDim2.new(0, 152, 0, 40), Position = UDim2.new(0.5, -76, 1, -62)}):Play()\nend)\n\nresetBtn.MouseButton1Up:Connect(function()\n\tTweenService:Create(resetBtn, TweenInfo.new(0.06), {Size = UDim2.new(0, 160, 0, 44), Position = UDim2.new(0.5, -80, 1, -64)}):Play()\n\tresetRemote:FireServer()\nend)\n\nstateRemote.OnClientEvent:Connect(function(data)\n\tif not data then return end\n\tcounterLabel.Text = string.format(\"Popped: %d / %d\", data.poppedCount, data.totalCount)\n\t\n\tif data.isComplete then\n\t\tcompletionBanner.Visible = true\n\t\tcompletionBanner.Position = UDim2.new(0.5, -170, 0.4, -26)\n\t\tTweenService:Create(completionBanner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {\n\t\t\tPosition = UDim2.new(0.5, -170, 0.45, -26)\n\t\t}):Play()\n\telse\n\t\tcompletionBanner.Visible = false\n\tend\nend)\n",
              "reason": "Client presentation script delivering responsive desktop and touch ASMR UI, live counter display, completion banner animation, and tactile sheet reset trigger."
            }
