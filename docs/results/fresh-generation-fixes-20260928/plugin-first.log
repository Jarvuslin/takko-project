SOURCE_BEGIN

local folder=game:GetService('ReplicatedStorage'):WaitForChild("ForgeTest_12345678123412341234123456789012")

local SCOPE="Forge_Test"

local function runTests(ids)

 local results={}

 for _,id in ids do

  local done,ok,err=false,false,"Acceptance test timed out"

  local thread=task.spawn(function() ok,err=pcall(function() local fn=require(folder:WaitForChild(id));assert(type(fn)=="function","Test must return a function");fn({scope=SCOPE}) end);done=true end)

  local deadline=os.clock()+12

  repeat task.wait() until done or os.clock()>deadline

  if not done then task.cancel(thread) end

  table.insert(results,{id=id,status=done and ok and "passed" or "failed",detail=done and ok and "Assertion scenario completed in Studio" or tostring(err)})

 end

 return results

end



local clientResults=nil

folder.Results.OnServerEvent:Connect(function(_,r) if type(r)=='table' then clientResults=r end end)

local logs={}

game:GetService('LogService').MessageOut:Connect(function(message) if #logs<80 then table.insert(logs,string.sub(message,1,2000)) end end)

task.wait(3)

local checks=runTests({"testOne"})

local deadline=os.clock()+20

while false and not clientResults and os.clock()<deadline do task.wait(.2) end

for _,r in clientResults or {} do table.insert(checks,r) end

game:GetService('StudioTestService'):EndTest({checks=checks,logs=logs})

SOURCE_END

