        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "assetNeeds": {
        "maxItems": 16,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "requirementId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "kind": {
              "type": "string",
              "enum": [
                "Model",
                "MeshPart",
                "Audio",
                "Animation",
                "Image"
              ]
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "constraints": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "intent": {
              "type": "object",
              "properties": {
                "experienceRole": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "description": "Why this asset matters to the requested player experience, beyond its appearance."
                },
                "interaction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "description": "Player action, response and completion/reward timing; say explicitly when decorative or noninteractive."
                },
                "reusableFeatures": {
                  "minItems": 1,
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "description": "Existing geometry, behavior, animation or media to look for and inspect before authoring missing integration."
                },
                "relatedRequirementIds": {
                  "minItems": 1,
                  "maxItems": 40,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "description": "Actual requirement IDs grounding this purpose, including the asset's primary requirementId."
                }
              },
              "required": [
                "experienceRole",
                "interaction",
                "reusableFeatures",
                "relatedRequirementIds"
              ],
              "additionalProperties": false
            },
            "required": {
              "default": true,
              "type": "boolean"
            },
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "maxSize": {
              "default": 12,
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 200
            }
          },
          "required": [
            "id",
            "requirementId",
            "role",
            "kind",
            "query",
            "constraints",
            "position"
          ],
          "additionalProperties": false
        }
      },
      "mechanics": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "assumptions": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "unresolved": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          }
        },
        "required": [
          "text",
          "assumptions",
          "unresolved"
        ],
        "additionalProperties": false
      },
      "theme": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "assumptions": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "unresolved": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          }
        },
        "required": [
          "text",
          "assumptions",
          "unresolved"
        ],
        "additionalProperties": false
      },
      "environment": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "assumptions": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "unresolved": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
