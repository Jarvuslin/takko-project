    "scripts": [
      {
        "name": "Chocolate Nado.Car1.Flinging Script.",
        "source": "function ot(hit)\n\tch = hit:GetChildren()\n\tfor i = 1, #ch do\n\t\tif ch[i].className == \"BodyVelocity\" then\n\t\t\tch[i].velocity = ch[i].velocity*-1\n\t\tend\n\tend\n\t\n\tif hit.Parent ~= nil then\n\t\tif hit.Parent:FindFirstChild(\"Humanoid\") ~= nil then\n\t\t\tif hit.Parent ~= script.Parent.Parent then\n\t\t\t\tif hit.Parent:FindFirstChild(\"Torso\") ~= nil then\n\t\t\t\t\thit.Parent.Torso.Velocity = (hit.Parent.Torso.Position - script.Parent.Position)*5\n\t\t\t\t\thit.Parent.Torso.RotVelocity = (hit.Parent.Torso.Position - script.Parent.Position)*10\n\t\t\t\tend\n\t\t\t\thit.Parent.Humanoid.PlatformStand = true\n\t\t\tend\n\t\telse\n\t\t\t\thit:breakJoints()\n\t\t\t\tif hit.Anchored == false then\n\t\t\t\t\thit.Velocity = hit.Velocity*-1 + ((hit.Position - script.Parent.Position)*1000)/hit:GetMass()\n\t\t\t\tend\n\t\t\t\n\t\tend\n\tend\n\tif hit.Parent ~= nil then\n\t\tif hit.Parent:FindFirstChild(\"Humanoid\") ~= nil then\n\t\t\tif hit.Parent ~= script.Parent.Parent then\n\t\t\t\twait(0.5)\n\t\t\t\thit.Parent.Humanoid.PlatformStand = false\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction remove(child)\n\tchild:Remove()\nend\nscript.Parent.Touched:connect(ot)\nscript.Parent.ChildAdded:connect(remove)"
      },
      {
        "name": "Chocolate Nado.Car1.Break Joints.",
        "source": "function onTouched(hit)\n\thit:BreakJoints()\nend\nscript.Parent.Touched:Connect(onTouched)\n"
      },
      {
        "name": "Chocolate Nado.Car1.PumpkinSpawningScript",
        "source": "wait(10)\nwhile wait(1) do\n    clone = game.ReplicatedStorage.Pumpkin:Clone()\n    clone.Parent = game.Workspace\n    clone.Position = script.Parent.Position + Vector3.new(\n        math.random(script.Parent.Size.X/-2,script.Parent.Size.X/2),\n        math.random(script.Parent.Size.Y/-2,script.Parent.Size.Y/2),\n        math.random(script.Parent.Size.Z/-2,script.Parent.Size.Z/2)\n    )\nend\n"
      },
      {
        "name": "Chocolate Nado.Car1.Script",
        "source": "while true do\n\tscript.Parent.CFrame = script.Parent.CFrame * CFrame.fromEulerAnglesXYZ(0, math.rad(5), 0)\n\twait()\nend\n"
      },
      {
        "name": "Chocolate Nado.Car1.Destroy",
        "source": "function touched(part)\n\tif part.Name == \"Base\" or part.Name == \"Baseplate\" then return\n\telse\n\t\tpart.Anchored = false\t\n\tend\n\t\nend\nscript.Parent.Touched:Connect(touched)"
      },
      {
        "name": "Chocolate Nado.Car1.FlingingScript",
        "source": "wait(10)\nfunction onTouched(hit)\n\tlocal humanoid = hit.Parent:FindFirstChild(\"Humanoid\")\n\tif humanoid == nil then\n\t\thit:BreakJoints()\n\tend\n\tif humanoid ~= nil then\n\t\thumanoid.Sit = true\n\t\thumanoid:TakeDamage(1)\n\tend\n\tlocal bv = Instance.new(\"BodyVelocity\")\n\tbv.Parent = hit\n\tbv.MaxForce = Vector3.new(1e12,1e12,1e12)\n\tbv.Velocity = Vector3.new(math.random(-300,300), 300, math.random(-300,300))\n\tbv.P = 1500\n\twait()\n    bv:Destroy()\n    if hit.Size.X < 15 and hit.Size.Y < 15 and hit.Size.Z < 15 then\n        if humanoid == nil and hit.Name ~= \"Shark\" then\n            game.Debris:AddItem(hit,5)\n        end\n    end\nend\nscript.Parent.Touched:Connect(onTouched)"
      },
      {
        "name": "Chocolate Nado.Tornado",
        "source": "s = script\ng = game.Workspace\nCar = s.Parent.Car1\n\nfunction checkifout()\n\tlocal p = Car.Position\n\tprint(p.X..\", \"..p.Z)\n\tif p.X > 256 or p.X < -256 or p.Z > 256 or p.Z < -256 then\n\t\treturn true\n\telse\n\t\treturn false\n\tend\nend\n\nwhile true do\nlocal c = checkifout()\nif c then\n\tCar.BodyPosition.maxForce = Vector3.new(5e7, 5e7, 5e7)\n\tCar.BodyVelocity.maxForce = Vector3.new(0, 1e10, 0)\nelse\n\tCar.BodyPosition.maxForce = Vector3.new(0, 0, 0)\n\tCar.BodyVelocity.maxForce = Vector3.new(5e7, 1e10, 5e7)\nend\nwait(5) \nlocal m = math.random(1,4) \nif m == 1 then\nCar.BodyVelocity.velocity = Vector3.new(53, 0, 0)\nwait(5)\nCar.BodyVelocity.velocity = Vector3.new(0, 0, 0)\nend\nif m == 2 then\nCar.BodyVelocity.velocity = Vector3.new(-53, 0, 0)\nwait(5)\nCar.BodyVelocity.velocity = Vector3.new(0, 0, 0)\nend\nif m == 3 then\nCar.BodyVelocity.velocity = Vector3.new(0, 0, 53)\nwait(5)\nCar.BodyVelocity.velocity = Vector3.new(0, 0, 0)\nend\nif m == 4 then\nCar.BodyVelocity.velocity = Vector3.new(0, 0, -53)\nwait(5)\nCar.BodyVelocity.velocity = Vector3.new(0, 0, 0)\nend\nend\n\n"
      },
      {
        "name": "Chocolate Nado.AttachmentPart.BodyPosition.Script",
        "source": "while true do\n    script.Parent.Position = script.Parent.Parent.Parent.Car1.Position + Vector3.new(0, 300, 0)\n    wait()\nend\n"
      },
      {
        "name": "Chocolate Nado.Union.Script",
        "source": "while true do\n\tlocal random_num1 = math.random(-255,255)\n\tlocal random_num2 = math.random(-255,255)\nrepeat\nscript.Parent.Position = script.Parent.Position - Vector3.new(0,10,0)\nwait(0.1)\nuntil script.Parent.Position.Y < 1\nwait(0.1)\nlocal explosion = Instance.new(\"Explosion\",script.Parent)\nexplosion.BlastRadius = 10\nexplosion.DestroyJointRadiusPercent = 50\nexplosion.Position = script.Parent.Position\nscript.Parent.Position = Vector3.new(random_num1,251,random_num2)\nwait(1)\t\nend"
      },
