    "scripts": [
      {
        "name": "Model.Egg.Spin Script V 1.3.1",
        "source": "spinning = script.Parent\n\nwhile true do\nspinning.CFrame = spinning.CFrame * CFrame.fromEulerAnglesXYZ(0,(10),0)\nwait(2.00)\nend\n"
      },
      {
        "name": "Model.Pet.Attachment.Seat.Script",
        "source": "\nWeld = nil\nPlayer = script.Parent.Player\nScript2 = nil\nS = false\n\nfunction Click(P)\n\tif P.Character.Humanoid.Sit == false then\n\tif S == false then\n\tS = true\n\tPlayer.Value = P.Character\n\tWeld = Instance.new(\"Weld\", Player)\n\tWeld.Part0 = Player.Value.HumanoidRootPart\n\tWeld.Part1 = script.Parent\n\tPlayer.Value.Humanoid.Sit = true\n\tScript2 = script.Script2:Clone()\n\tScript2.Parent = Player.Value\n\tScript2.Disabled = false\n\tend\n\tend\nend\n\nfunction Jump()\n\tS = false\n\tWeld:Destroy()\n\tPlayer.Value = nil\nend\n\nscript.Parent.ClickDetector.MouseClick:Connect(Click)\nscript.Parent.Jump.Event:Connect(Jump)"
      },
      {
        "name": "Model.Pet.Attachment.Seat.Script.Script2",
        "source": "\nfunction Jump()\n\tif script.Parent.Humanoid.Jump == true then\n\t\tscript.JumpEvent.Value:Fire()\n\tend\nend\n\nscript.Parent.Humanoid.Changed:Connect(Jump)"
      }
    ],
