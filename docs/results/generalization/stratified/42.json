    "scripts": [
      {
        "name": "Gun.Shoot",
        "source": "local gun = script.Parent\nlocal re = script.Parent:WaitForChild(\"RemoteEvent\")\nlocal player = nil\nlocal mouse = nil\nlocal connection = nil\n\nlocal function onActivated()\n\tre:FireServer(mouse.Target)\nend\n\ngun.Equipped:Connect(function()\n\tplayer = game.Players.LocalPlayer\n\tmouse = player:GetMouse()\n\tconnection = gun.Activated:Connect(onActivated)\nend)\n\ngun.Unequipped:Connect(function()\n\tplayer = nil\n\tmouse = nil\n\tconnection:Disconnect()\nend)"
      },
      {
        "name": "Gun.Damage",
        "source": "local re = script.Parent:WaitForChild(\"RemoteEvent\")\nlocal damage = 20\nlocal bang = script.Parent.Gun.Pew\n\nlocal function onShoot(player, target)\n\tbang:Play()\n\tif target and target.Parent then\n\t\tlocal hum = target.Parent:FindFirstChild(\"Humanoid\")\n\t\tif hum then\n\t\t\thum:TakeDamage(damage)\n\t\tend\n\tend\nend\n\nre.OnServerEvent:Connect(onShoot)"
      }
