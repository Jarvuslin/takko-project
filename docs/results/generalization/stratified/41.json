        "source": "--[[\n\n░██████╗████████╗░█████╗░██████╗░\n██╔════╝╚══██╔══╝██╔══██╗██╔══██╗\n╚█████╗░░░░██║░░░██║░░██║██████╔╝\n░╚═══██╗░░░██║░░░██║░░██║██╔═══╝░\n██████╔╝░░░██║░░░╚█████╔╝██║░░░░░\n╚═════╝░░░░╚═╝░░░░╚════╝░╚═╝░░░░░\n\n           \t\t\t\t\t* DO NOT PROCEED *\n    This is the original code made by * @IIRebelll | Rebel*\n    Link to profile: https://www.roblox.com/users/173316821/profile\n    Continuing past this may cause damage do the script, proceed with caution\n\n--]]\n\n\n\n\n\n\n\n\nlocal char = script.Parent\n\nlocal RS = game:GetService(\"RunService\")\n\nlocal Mouse = game.Players.LocalPlayer:GetMouse()\n\nlocal UIS = game:GetService(\"UserInputService\")\n\nlocal FlashlightOn = false\n\nlocal Animations = require(script:WaitForChild(\"Animations\"))\n\nlocal TS = game:GetService(\"TweenService\")\nlocal TI = TweenInfo.new(0.1, Enum.EasingStyle.Sine)\n\nlocal Walk = TweenInfo.new(1, Enum.EasingStyle.Sine)\n\nlocal FP = Instance.new(\"Part\", char)\nFP.CanCollide = false\nFP.Anchored = true\nFP.Size = Vector3.new(1,1,1)\nFP.Name = \"FlashlightAttachPart\"\n\nfunction CreateFlashlight()\n\tlocal FL = script.RayTracedSpotLight:Clone()\n\tFL.Parent = FP\n\tFL.CanCollide = false\n\tFL.Anchored = true\n\tFL.Size = Vector3.new(1,1,1)\n\tFL.Name = \"Flashlight\"\n\n\treturn FL\t\nend\n\nfunction RemoveFlashlight()\n\tfor i, v in pairs(char:GetDescendants()) do\n\t\tif v.Name == \"Flashlight\" then\n\t\t\tv:Destroy()\n\t\tend\n\tend\nend\n\nlocal FL = CreateFlashlight()\n\nRS.RenderStepped:Connect(function()\n\tFP.CFrame = workspace.CurrentCamera.CFrame\n\tFP.CFrame = CFrame.lookAt(FP.Position, Mouse.Hit.Position)\n\t\n\tlocal Distance = (FL.Position - Mouse.Hit.Position).Magnitude\n\tTS:Create(FL, TI, {CFrame = CFrame.lookAt(FL.Position, Mouse.Hit.Position)}):Play()\n\t\n\tFL.SurfaceLight.Brightness = math.clamp(Distance, 0, 5)\n\tFL.Position = FP.CFrame.Position\nend)"
      },
      {
        "name": "Flashlight.Flashlight.RayTracedSpotLight.LocalScript",
        "source": "local Animations = require(script:WaitForChild(\"Animations\"))\n\nlocal RayTraces = 0\nlocal Spread = script.Parent.Spread.Value\n\nfunction CreateLightBounce(X, Y)\n\tlocal Part = Instance.new(\"Part\")\n\tPart.Parent = script.Parent\n\tPart.CanCollide = false\n\tPart.Anchored = true\n\tPart.Size = Vector3.new(0,0,0)\n\tPart.Transparency = 1\n\tPart.Name = \"RayTrace\"\n\n\tlocal PointLight = Instance.new(\"PointLight\")\n\tPointLight.Shadows = true\n\tPointLight.Range = 30\n\tPointLight.Color =script.Parent.SurfaceLight.Color\n\n\tPointLight.Parent = Part\n\n\n\tgame[\"Run Service\"].RenderStepped:Connect(function()\n\n\t\tlocal Origin = script.Parent.CFrame.Position\n\t\tlocal Direction = (script.Parent.CFrame * CFrame.Angles(math.rad(X), math.rad(Y), 0)).LookVector * 1000\n\n\t\tlocal RayParams = RaycastParams.new()\n\t\tRayParams.FilterDescendantsInstances = {script.Parent:GetChildren(), game.Players.LocalPlayer.Character}\n\t\tRayParams.FilterType = Enum.RaycastFilterType.Blacklist\n\n\t\tlocal rayResult = workspace:Raycast(Origin, Direction, RayParams)\n\n\t\tif rayResult then\n\n\t\t\tif script.Parent.On.Value == true then\n\t\t\t\t\n\t\t\t\tscript.Parent.SurfaceLight.Enabled = true\n\n\t\t\t\tfor i, v in pairs(script.Parent:GetChildren()) do\n\t\t\t\t\tif v.Name == \"RayTrace\" then\n\t\t\t\t\t\tv.PointLight.Enabled = true\n\t\t\t\t\tend\n\t\t\t\tend\n\n\t\t\t\tAnimations:Tween(script.Parent.Parent, {Color = Color3.fromRGB(255, 255, 255)}, 0.1)\n\n\t\t\t\t\n\t\t\t\t\n\t\t\t\tif rayResult.Material == Enum.Material.Glass then\n\t\t\t\t\tAnimations:Tween(script.Parent.SurfaceLight, {Color = rayResult.Instance.Color}, 0.1)\n\t\t\t\telse\n\t\t\t\t\tAnimations:Tween(script.Parent.SurfaceLight, {Color = Color3.fromRGB(255, 255, 255)}, 0.1)\n\t\t\t\tend\n\n\t\t\t\tlocal Distance = 1 / (Origin - rayResult.Position).Magnitude / 6\n\t\t\t\t\n\t\t\t\tDistance = math.clamp(Distance, 0, 0.25)\n\n\t\t\t\tAnimations:Tween(PointLight, {Color = rayResult.Instance.Color}, 0.1)\n\n\t\t\t\tPointLight.Brightness = Distance\n\n\t\t\t\tPart.Position = rayResult.Position\n\t\t\t\t\n\t\t\telse\n\n\t\t\t\tAnimations:Tween(script.Parent.SurfaceLight, {Color = Color3.fromRGB(0, 0, 0)}, 0.1)\n\n\t\t\t\tAnimations:Tween(script.Parent.Parent, {Color = Color3.fromRGB(0, 0, 0)}, 0.1)\n\n\t\t\t\tfor i, v in pairs(script.Parent:GetChildren()) do\n\t\t\t\t\tif v.Name == \"RayTrace\" then\n\t\t\t\t\t\tAnimations:Tween(PointLight, {Color = Color3.fromRGB(0, 0, 0)}, 0.1)\n\t\t\t\t\tend\n\t\t\t\tend\n\n\t\t\tend\n\n\t\tend\n\n\tend)\n\nend\n\nfor i = 0, RayTraces do\n\tlocal x, y = math.random(-Spread*100, Spread*100) / 100, math.random(-Spread*100, Spread*100) / 100\n\tCreateLightBounce(x, y)\nend"
      },
      {
        "name": "Flashlight.Flashlight.RayTracedSpotLight.LocalScript.Animations",
        "source": "local Animations = {}\n\nlocal TweenSpeed = 0.1\nlocal EasingStyle = Enum.EasingStyle.Sine\n\nlocal TS = game:GetService(\"TweenService\")\n\nfunction Animations:Tween(Object, properties, speed)\n\tlocal TI = TweenInfo.new(speed, EasingStyle)\n\tlocal tween = TS:Create(Object, TI, properties)\n\ttween:Play()\nend\n\nreturn Animations\n"
      },
      {
        "name": "Flashlight.Flashlight.RayTracedSpotLight.SurfaceLight.LocalScript",
        "source": "local UIS = game:GetService(\"UserInputService\")\n\nlocal Enabled = true\n\nUIS.InputBegan:Connect(function(input)\n\tif input.KeyCode == Enum.KeyCode.F then\n\t\tif not Enabled then\n\t\t\tscript.Parent.Sound:Play()\n\t\t\tEnabled = true\n\t\t\tscript.Parent.Range = 60\n\t\telse\n\t\t\tscript.Parent.Sound:Play()\n\t\t\tEnabled = false\n\t\t\tscript.Parent.Range = 0\n\t\tend\n\tend\nend)\n"
      },
      {
        "name": "Flashlight.Flashlight.Animations",
        "source": "local Animations = {}\n\nlocal TweenSpeed = 0.4\nlocal EasingStyle = Enum.EasingStyle.Sine\nlocal EasingDirection = Enum.EasingDirection.In\n\nlocal TS = game:GetService(\"TweenService\")\nlocal TI = TweenInfo.new(TweenSpeed, EasingStyle, EasingDirection)\n\nfunction Animations:Tween(Object, properties)\n\tlocal tween = TS:Create(Object, TI, properties)\n\ttween:Play()\nend\n\nreturn Animations\n"
      },
