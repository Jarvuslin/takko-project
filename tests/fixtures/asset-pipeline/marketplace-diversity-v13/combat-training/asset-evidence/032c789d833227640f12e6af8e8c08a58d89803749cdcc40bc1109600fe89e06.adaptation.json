  "plan": {
    "packetHash": "100da40def0758a51b18c4a5d454a014bdbc29e06c07dce3193fccba922a42c1",
    "inputHash": "d49b283c0755f77ce5e7ca710e9c74c8f8d1522e5a37513e9b97af324ecb3296",
    "reason": "Preserve reusable R15 KeyframeSequence animations, impact and swing audio assets, hit particle emitters, and combat settings while removing the unsafe, unrelated day/night lighting script with missing dynamic dependencies and replacing legacy unscoped script logic with safe namespace-scoped bindings.",
    "removeSubtrees": [
      {
        "index": 172,
        "reason": "Remove unrelated day/night CoreSkyboxSystem script which contains an unresolved dynamic require and persistent unmanaged lighting listeners."
      }
    ],
    "replaceSources": [
      {
        "index": 22,
        "beforeSha256": "d68471e36478a852b30d99ca608db668474710baaa03077d1dd3762c611d2547",
        "source": "-- Adapted Server Combat component interface\n-- Scoped to Forge_d451eccc9382 namespace\nlocal Debris = game:GetService(\"Debris\")\nlocal combatFolder = script.Parent:FindFirstChild(\"CombatSystem\")\n\nif combatFolder then\n\tlocal punchingRemote = combatFolder:FindFirstChild(\"Punching\")\n\tif punchingRemote and punchingRemote:IsA(\"RemoteEvent\") then\n\t\tpunchingRemote.OnServerEvent:Connect(function(player)\n\t\t\t-- Server authoritative validation will be handled by the training arena manager\n\t\tend)\n\tend\nend\n",
        "reason": "Replace unscoped global raycasting, permanent Heartbeat leaks, and PvP damage with safe namespace-bound server component initialization."
      },
      {
        "index": 23,
        "beforeSha256": "ed268dde343a969ecc37ee4f18cd9071f66fba08e12286a2a2b8f2dfaab8c211",
        "source": "-- Adapted Client Combat component interface\n-- Client controls and touch bindings will be integrated via StarterPlayerScripts / StarterGui\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n",
        "reason": "Neutralize invalid script.Parent.Humanoid assumption in unparented LocalScript; full desktop and touch input integration will be mounted in StarterPlayerScripts."
      }
    ],
    "preservedBehavior": [
      "Preserved R15 KeyframeSequences for LeftPunch (index 25), RightPunch (index 87), and Block (index 148) under Animations model.",
      "Preserved impact audio assets Punched1 (index 9, rbxassetid://3932504231) and Punched2 (index 8, rbxassetid://4306980885) along with Swing audio (index 10, rbxassetid://4059010105).",
      "Preserved HitEffect (index 12) and BlockEffect (index 11) ParticleEmitter visual assets.",
      "Preserved CombatSystem configuration folder (index 14) and RemoteEvent (index 13)."
    ],
    "remainingIntegration": [
      "Acquire or connect third light-combo finisher animation and dummy reaction/defeat animations to complete the three-hit combo requirement.",
      "Implement server-authoritative cadence and distance validation strictly targeting the single training dummy inside Forge_d451eccc9382.",
      "Build HUD displaying dummy health, exact accepted-hit counter, and clear contextual Hit/Miss feedback.",
      "Author discrete desktop and touch Attack and Reset controls with debounce and hold-prevention guards.",
      "Implement automatic dummy restoration upon defeat and manual reset flow with complete lifecycle cleanup."
    ],
    "nativeTestPlan": [
      "Verify that CoreSkyboxSystem is removed and produces no script errors or unresolved require warnings.",
      "Inspect preserved KeyframeSequences and verify compatibility with standard R15 humanoid avatar rigs.",
      "Audit Punched1, Punched2, and Swing sound assets natively for loading, loudness balance, and audibility.",
      "Verify server damage and counter increment occur exactly once per accepted in-range contact phase.",
      "Test desktop and touch attack controls to confirm rapid tapping or holding does not cause multi-hit spam."
    ],
    "runtimeVerification": "not_performed"
  },
