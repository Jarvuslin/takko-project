local Core = require("../recipes/combat/CombatCore")
local abilities = {strike={cooldown=1}, burst={cooldown=4}}
local passed=0
local function test(name,fn) fn(); passed+=1; print("PASS "..name) end
test("accepted strike and exact cooldown boundary",function()
 local state=Core.newState()
 assert(Core.accept(state,"strike",1,0,true,abilities))
 local ok,reason=Core.accept(state,"strike",2,0.5,true,abilities)
 assert(not ok and reason=="cooldown")
 assert(Core.accept(state,"strike",2,1,true,abilities))
end)
test("replayed or out of order requests cannot attack twice",function()
 local s=Core.newState(); assert(Core.accept(s,"strike",5,0,true,abilities))
 assert(not Core.accept(s,"burst",5,2,true,abilities))
 assert(not Core.accept(s,"burst",4,3,true,abilities))
end)
test("malformed action and sequence values are rejected",function()
 local s=Core.newState()
 for _,value in {0,-1,0.5,math.huge,0/0,"1",{}} do assert(not Core.accept(s,"strike",value,0,true,abilities)) end
 assert(not Core.accept(s,{},1,0,true,abilities))
 assert(not Core.accept(s,"god_mode",1,0,true,abilities))
end)
test("dead player cannot attack and respawn has fresh state",function()
 local s=Core.newState(); assert(not Core.accept(s,"strike",1,0,false,abilities))
 assert(Core.accept(Core.newState(),"strike",1,0,true,abilities))
end)
test("ability cooldowns are independent",function()
 local s=Core.newState();assert(Core.accept(s,"strike",1,0,true,abilities))
 assert(Core.accept(s,"burst",2,0.1,true,abilities))
 assert(not Core.accept(s,"burst",3,2,true,abilities))
end)
test("damage requires range visibility and a living target",function()
 assert(Core.canHit(8,8,100,true));assert(not Core.canHit(8.1,8,100,true))
 assert(not Core.canHit(2,8,0,true));assert(not Core.canHit(2,8,100,false))
 assert(not Core.canHit(0/0,8,100,true));assert(not Core.canHit(-1,8,100,true))
end)
print(string.format("%d combat scenarios passed (offline, not Studio)",passed))
