import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {conceptOutputSchema} from '../../src/generation/concept';
const dir=path.resolve('research/results/concept-live-v3');
const read=(name:string)=>JSON.parse(fs.readFileSync(path.join(dir,name),'utf8'));
const ledger=read('ledger.json');
assert.equal(ledger.length,1);
const row=ledger[0],request=read('initial-request.json'),response=read('initial-response.json'),project=read('initial-project.json');
assert.equal(row.stage,'initial');assert.equal(row.status,'reconciled');
assert.equal(createHash('sha256').update(JSON.stringify(request)).digest('hex'),row.requestHash);
const expected=Buffer.byteLength(request.messages.map((m:any)=>m.content).join(''))+Buffer.byteLength(JSON.stringify(request.response_format.json_schema.schema))+1024+request.max_tokens*5;
assert.equal(row.reservedMicros,expected);
assert.equal(expected,18439);
assert.equal(request.response_format.type,'json_schema');assert.equal(request.response_format.json_schema.strict,true);
assert.deepEqual(request.provider.order,['Anthropic']);assert.equal(request.provider.allow_fallbacks,false);assert.equal(request.provider.require_parameters,true);
assert.equal(response.id,row.receipt.id);assert.equal(response.provider,'Anthropic');
assert.equal(response.usage.cost,row.receipt.costUsd);
assert.equal(response.usage.prompt_tokens,row.receipt.inputTokens);assert.equal(response.usage.completion_tokens,row.receipt.outputTokens);
assert.ok(Math.abs(row.receipt.costUsd-(row.receipt.inputTokens+row.receipt.outputTokens*5)/1e6)<1e-9);
assert.equal(conceptOutputSchema.safeParse(JSON.parse(response.choices[0].message.content)).success,true);
assert.equal(project.stage,'clarification');assert.equal(project.concept.readiness,'needs_choices');assert.equal(project.spec,null);
assert.equal(project.charges.length,1);
assert.equal(project.charges[0].chargedMicros,5008);
assert.equal(read('initial-review.json').passed,false);assert.equal(read('stopped.json').stage,'initial');
for(const stage of ['clarify','plan','clear']) assert.equal(fs.existsSync(path.join(dir,stage+'.attempted.lock')),false);
const before=read('key-before.json'),after=read('key-after.json');
assert.ok(Math.abs(before.remaining-after.remaining-row.receipt.costUsd)<1e-9);
const protocol=read('protocol.json');
assert.equal(protocol.ceilingUsd,5);assert.equal(read('authorization.json').ceilingMicros,5000000);
for(const [file,hash] of Object.entries(protocol.sourceHashes))assert.equal(createHash('sha256').update(fs.readFileSync(file,'utf8')).digest('hex'),hash);
const scan=(folder:string):string[]=>fs.readdirSync(folder,{withFileTypes:true}).flatMap(item=>item.isDirectory()?scan(path.join(folder,item.name)):[path.join(folder,item.name)]);
const textFiles=scan(dir).filter(file=>/\.(json|md|txt|html|mjs|mts|ps1|srt)$/.test(file));
assert.equal(textFiles.filter(file=>/sk-or-v1-[a-z0-9]{30,}/i.test(fs.readFileSync(file,'utf8'))).length,0);
const prior=['v1','v2'].flatMap(v=>JSON.parse(fs.readFileSync('research/results/concept-live-'+v+'/ledger.json','utf8')));
const combinedReservations=prior.reduce((n:number,r:any)=>n+r.reservedMicros,0)+row.reservedMicros;
const combinedActual=prior.reduce((n:number,r:any)=>n+r.receipt.costUsd,0)+row.receipt.costUsd;
assert.equal(combinedReservations,64752);assert.ok(combinedReservations<=5000000);
const audit={at:new Date().toISOString(),outcome:'Failed first semantic gate, no further dispatches',contractPassed:true,semanticPassed:false,paidCalls:1,actualUsd:row.receipt.costUsd,reservedUsd:row.reservedMicros/1e6,combinedHistoricalActualUsd:combinedActual,combinedHistoricalReservationsUsd:combinedReservations/1e6,settledRemaining:after.remaining,balanceAt:after.at,settledDeductionMatchesReceipt:true,sourceHashesUnchanged:true,requestHashVerified:true,secretPatternMatches:0,textArtifactsScanned:textFiles.length,model:row.receipt.model,provider:row.receipt.provider,noStudioSession:true};
fs.writeFileSync(path.join(dir,'audit.json'),JSON.stringify(audit,null,2)+'\n');
console.log(JSON.stringify(audit));
