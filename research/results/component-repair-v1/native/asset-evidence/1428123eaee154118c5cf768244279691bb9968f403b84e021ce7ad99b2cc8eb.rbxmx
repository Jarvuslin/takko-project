          <Item class="Script" referent="313">
            <Properties>
              <string name="Name">Script</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">18014364136639232</SecurityCapabilities>
              <bool name="Disabled">false</bool>
