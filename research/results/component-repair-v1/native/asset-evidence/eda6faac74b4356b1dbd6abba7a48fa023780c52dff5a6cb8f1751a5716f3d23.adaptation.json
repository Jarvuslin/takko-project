        "source": "local TweenService = game:GetService(\"TweenService\")\nlocal part = script.Parent\nlocal clickDetector = part:FindFirstChildOfClass(\"ClickDetector\")\nlocal popSound = part:FindFirstChildOfClass(\"Sound\")\nlocal mesh = part:FindFirstChildOfClass(\"SpecialMesh\")\n\nlocal originalSize = mesh and mesh.Scale or Vector3.new(1, 1, 1)\nlocal originalTransparency = part.Transparency\nlocal originalColor = part.Color\n\npart:SetAttribute(\"Popped\", false)\npart:SetAttribute(\"State\", \"Intact\")\n\nlocal isBusy = false\n\nlocal function onReset()\n\tisBusy = false\n\tpart:SetAttribute(\"Popped\", false)\n\tpart:SetAttribute(\"State\", \"Intact\")\n\tif clickDetector then\n\t\tclickDetector.MaxActivationDistance = 32\n\tend\n\tif mesh then\n\t\tmesh.Scale = originalSize\n\tend\n\tpart.Transparency = originalTransparency\n\tpart.Color = originalColor\nend\n\nlocal function onPop(player)\n\tif isBusy or part:GetAttribute(\"Popped\") == true then\n\t\treturn\n\tend\n\tisBusy = true\n\tpart:SetAttribute(\"State\", \"Pressing\")\n\tif clickDetector then\n\t\tclickDetector.MaxActivationDistance = 0\n\tend\n\n\t-- Phase 1: Visible depression\n\tif mesh then\n\t\tlocal depressTween = TweenService:Create(mesh, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {\n\t\t\tScale = Vector3.new(originalSize.X * 1.1, originalSize.Y * 0.4, originalSize.Z * 1.1)\n\t\t})\n\t\tdepressTween:Play()\n\t\tdepressTween.Completed:Wait()\n\telse\n\t\ttask.wait(0.08)\n\tend\n\n\t-- Phase 2: Distinct pop moment with synchronized audio\n\tpart:SetAttribute(\"State\", \"Popping\")\n\tif popSound then\n\t\tpopSound:Play()\n\tend\n\n\t-- Phase 3: Settle into recessed collapsed state\n\tif mesh then\n\t\tlocal settleTween = TweenService:Create(mesh, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {\n\t\t\tScale = Vector3.new(originalSize.X * 0.9, originalSize.Y * 0.15, originalSize.Z * 0.9)\n\t\t})\n\t\tsettleTween:Play()\n\t\tsettleTween.Completed:Wait()\n\telse\n\t\ttask.wait(0.12)\n\tend\n\n\tpart.Transparency = math.clamp(originalTransparency + 0.35, 0, 0.85)\n\tpart:SetAttribute(\"State\", \"Popped\")\n\tpart:SetAttribute(\"Popped\", true)\n\tisBusy = false\nend\n\tif clickDetector then\n\tclickDetector.MouseClick:Connect(onPop)\nend\n\npart:GetAttributeChangedSignal(\"ResetTrigger\"):Connect(onReset)\n\n-- Takko two-hop serialization diagnostic only; no gameplay change.\n",
