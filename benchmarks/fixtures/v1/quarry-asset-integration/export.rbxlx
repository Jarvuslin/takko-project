Item class="Part" referent="RBX192"><Properties><string name="Name">Lantern2Cap</string><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="Anchored">true</bool><Vector3 name="Size"><X>1.1</X><Y>0.25</Y><Z>1.1</Z></Vector3><CoordinateFrame name="CFrame"><X>-10</X><Y>3.95</Y><Z>-17</Z><R00>0.7071067811865476</R00><R01>0</R01><R02>0.7071067811865475</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.7071067811865475</R20><R21>0</R21><R22>0.7071067811865476</R22></CoordinateFrame><Color3 name="Color"><R>0.21</R><G>0.28</G><B>0.35</B></Color3><token name="Material">1088</token></Properties></Item><Item class="Part" referent="RBX193"><Properties><string name="Name">Lantern3Post</string><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="Anchored">true</bool><Vector3 name="Size"><X>0.3</X><Y>3.2</Y><Z>0.3</Z></Vector3><CoordinateFrame name="CFrame"><X>10</X><Y>1.6</Y><Z>-17</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.39</R><G>0.26</G><B>0.18</B></Color3><token name="Material">512</token></Properties></Item><Item class="Part" referent="RBX194"><Properties><string name="Name">Lantern3Glow</string><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="Anchored">true</bool><Vector3 name="Size"><X>0.8</X><Y>1</Y><Z>0.8</Z></Vector3><CoordinateFrame name="CFrame"><X>10</X><Y>3.3</Y><Z>-17</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.97</R><G>0.88</G><B>0.66</B></Color3><token name="Material">288</token></Properties><Item class="PointLight" referent="RBX195"><Properties><string name="Name">Light</string><Color3 name="Color"><R>0.91</R><G>0.65</G><B>0.29</B></Color3><double name="Brightness">1.4</double><double name="Range">13</double><bool name="Shadows">false</bool></Properties></Item></Item><Item class="Part" referent="RBX196"><Properties><string name="Name">Lantern3Cap</string><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="Anchored">true</bool><Vector3 name="Size"><X>1.1</X><Y>0.25</Y><Z>1.1</Z></Vector3><CoordinateFrame name="CFrame"><X>10</X><Y>3.95</Y><Z>-17</Z><R00>0.7071067811865476</R00><R01>0</R01><R02>0.7071067811865475</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.7071067811865475</R20><R21>0</R21><R22>0.7071067811865476</R22></CoordinateFrame><Color3 name="Color"><R>0.21</R><G>0.28</G><B>0.35</B></Color3><token name="Material">1088</token></Properties></Item></Item></Item></Item></Item><Item class="ReplicatedStorage" referent="RBX197"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX198"><Properties><string name="Name">Forge_GenerationPilot</string></Properties><Item class="RemoteEvent" referent="RBX199"><Properties><string name="Name">Action</string></Properties></Item><Item class="RemoteEvent" referent="RBX200"><Properties><string name="Name">Feedback</string></Properties></Item><Item class="ModuleScript" referent="RBX201"><Properties><string name="Name">Contract</string><ProtectedString name="Source">local Contract = {
	CAPACITIES = {8, 14, 20},
	POWER_YIELDS = {1, 2, 3},
	POWER_COSTS = {40, 100},
	CAPACITY_COSTS = {30, 80},
	SELL_VALUE = 5,
	INTERACT_DISTANCE = 10,
	ACTION_COOLDOWN = 0.2,
	HARVEST_COOLDOWN = 0.65,
	NODE_CAPACITY = 6,
	NODE_RESPAWN = 6,
	GOAL_SOLD = 40,
}

return Contract</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX202"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX203"><Properties><string name="Name">Forge_GenerationPilot</string></Properties><Item class="ModuleScript" referent="RBX204"><Properties><string name="Name">World</string><ProtectedString name="Source">local World = {}

local function required(parent, name, className)
	local instance = parent:FindFirstChild(name)
	assert(instance, &quot;Missing authored world object: &quot; .. name)
	if className then
		assert(instance:IsA(className), name .. &quot; must be a &quot; .. className)
	end
	return instance
end

local function requiredBasePart(parent, name)
	return required(parent, name, &quot;BasePart&quot;)
end

local function requireShardCluster(nodeId, node)
	local count = 0
	for _, child in ipairs(node:GetChildren()) do
		if child:IsA(&quot;BasePart&quot;) then
			count += 1
		end
	end
	assert(count &gt;= 2, nodeId .. &quot; must contain two shards alongside its main crystal&quot;)
end

local function requireSurfaceLabel(signName, sign)
	local surfaceGui = required(sign, &quot;SurfaceGui&quot;, &quot;SurfaceGui&quot;)
	local textLabel = surfaceGui:FindFirstChildOfClass(&quot;TextLabel&quot;)
	assert(textLabel, signName .. &quot; must contain a readable TextLabel&quot;)
end

function World.resolve(root)
	assert(root and root.Name == &quot;Forge_GenerationPilot&quot;, &quot;World resolver requires Workspace/Forge_GenerationPilot&quot;)
	local world = required(root, &quot;World&quot;, &quot;Folder&quot;)
	local nodesFolder = required(world, &quot;Nodes&quot;, &quot;Folder&quot;)
	local nodes = {}

	requiredBasePart(world, &quot;Ground&quot;)
	required(world, &quot;Spawn&quot;, &quot;SpawnLocation&quot;)
	for _, pathName in ipairs({&quot;PathSpawn&quot;, &quot;PathCross&quot;, &quot;PathBeacon&quot;}) do
		requiredBasePart(world, pathName)
	end
	for _, terraceName in ipairs({&quot;TerraceWest&quot;, &quot;TerraceEast&quot;}) do
		requiredBasePart(world, terraceName)
	end
	requiredBasePart(world, &quot;RampNorth&quot;)
	for _, archName in ipairs({&quot;ArchLeft&quot;, &quot;ArchRight&quot;, &quot;ArchTop&quot;}) do
		requiredBasePart(world, archName)
	end

	for index = 1, 6 do
		local nodeId = string.format(&quot;Node%02d&quot;, index)
		local node = requiredBasePart(nodesFolder, nodeId)
		requireShardCluster(nodeId, node)
		nodes[nodeId] = node
	end

	local sellSign = requiredBasePart(world, &quot;SellSign&quot;)
	local upgradeSign = requiredBasePart(world, &quot;UpgradeSign&quot;)
	requireSurfaceLabel(&quot;SellSign&quot;, sellSign)
	requireSurfaceLabel(&quot;UpgradeSign&quot;, upgradeSign)

	return {
		nodes = nodes,
		sell = requiredBasePart(world, &quot;SellStation&quot;),
		upgrades = requiredBasePart(world, &quot;UpgradeStation&quot;),
		beacon = requiredBasePart(world, &quot;Beacon&quot;),
		spawn = world:WaitForChild(&quot;Spawn&quot;),
	}
end

return World</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX205"><Properties><string name="Name">Economy</string><ProtectedString name="Source">local Contract = require(game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;Forge_GenerationPilot&quot;):WaitForChild(&quot;Contract&quot;))

local Economy = {}

local function result(ok, amount, message)
	return { ok = ok, amount = amount or 0, message = message }
end

local function updateGoal(state)
	if not state.GoalComplete
		and state.TotalSold &gt;= Contract.GOAL_SOLD
		and state.PowerLevel &gt;= 1
		and state.CapacityLevel &gt;= 1 then
		state.GoalComplete = true
		return true
	end
	return false
end

function Economy.newState()
	return {
		Carry = 0,
		Coins = 0,
		PowerLevel = 0,
		CapacityLevel = 0,
		Capacity = Contract.CAPACITIES[1],
		TotalSold = 0,
		GoalComplete = false,
	}
end

function Economy.apply(state, action, nodeRemaining)
	if type(action) ~= &quot;string&quot; then
		return result(false, 0, &quot;Unknown action.&quot;)
	end

	if action == &quot;harvest&quot; then
		if type(nodeRemaining) ~= &quot;number&quot; or nodeRemaining &lt;= 0 then
			return result(false, 0, &quot;That node is empty. It will refill soon.&quot;)
		end
		local freeSpace = state.Capacity - state.Carry
		if freeSpace &lt;= 0 then
			return result(false, 0, &quot;Your bag is full. Sell your crystals first.&quot;)
		end
		local yield = Contract.POWER_YIELDS[state.PowerLevel + 1]
		local amount = math.min(yield, freeSpace, nodeRemaining)
		if amount &lt;= 0 then
			return result(false, 0, &quot;Nothing to harvest.&quot;)
		end
		state.Carry += amount
		return result(true, amount, string.format(&quot;Harvested %d crystal%s.&quot;, amount, amount == 1 and &quot;&quot; or &quot;s&quot;))
	end

	if action == &quot;sell&quot; then
		if state.Carry &lt;= 0 then
			return result(false, 0, &quot;Your bag is empty.&quot;)
		end
		local sold = state.Carry
		local coins = sold * Contract.SELL_VALUE
		state.Carry = 0
		state.Coins += coins
		state.TotalSold += sold
		updateGoal(state)
		return result(true, coins, string.format(&quot;Sold %d crystals for %d coins.&quot;, sold, coins))
	end

	if action == &quot;upgradePower&quot; then
		if state.PowerLevel &gt;= 2 then
			return result(false, 0, &quot;Pick power is already maxed.&quot;)
		end
		local cost = Contract.POWER_COSTS[state.PowerLevel + 1]
		if state.Coins &lt; cost then
			return result(false, 0, string.format(&quot;You need %d more coins for pick power.&quot;, cost - state.Coins))
		end
		state.Coins -= cost
		state.PowerLevel += 1
		updateGoal(state)
		return result(true, 0, string.format(&quot;Pick power upgraded: harvest %d each time.&quot;, Contract.POWER_YIELDS[state.PowerLevel + 1]))
	end

	if action == &quot;upgradeCapacity&quot; then
		if state.CapacityLevel &gt;= 2 then
			return result(false, 0, &quot;Bag capacity is already maxed.&quot;)
		end
		local cost = Contract.CAPACITY_COSTS[state.CapacityLevel + 1]
		if state.Coins &lt; cost then
			return result(false, 0, string.format(&quot;You need %d more coins for bag capacity.&quot;, cost - state.Coins))
		end
		state.Coins -= cost
		state.CapacityLevel += 1
		state.Capacity = Contract.CAPACITIES[state.CapacityLevel + 1]
		updateGoal(state)
		return result(true, 0, string.format(&quot;Bag upgraded: capacity %d.&quot;, state.Capacity))
	end

	return result(false, 0, &quot;Unknown action.&quot;)
end

return Economy</ProtectedString></Properties></Item><Item class="Script" referent="RBX206"><Properties><string name="Name">Game</string><ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local namespace = ReplicatedStorage:WaitForChild(&quot;Forge_GenerationPilot&quot;)
local Contract = require(namespace:WaitForChild(&quot;Contract&quot;))
local Economy = require(game:GetService(&quot;ServerScriptService&quot;):WaitForChild(&quot;Forge_GenerationPilot&quot;):WaitForChild(&quot;Economy&quot;))
local World = require(game:GetService(&quot;ServerScriptService&quot;):WaitForChild(&quot;Forge_GenerationPilot&quot;):WaitForChild(&quot;World&quot;))

local root = workspace:WaitForChild(&quot;Forge_GenerationPilot&quot;)
local authored = World.resolve(root)
local actionRemote = namespace:WaitForChild(&quot;Action&quot;)
local feedbackRemote = namespace:WaitForChild(&quot;Feedback&quot;)

local states = {}
local cooldowns = {}
local nodeState = {}
local originalNodeColors = {}

local validActions = {
	harvest = true,
	sell = true,
	upgradePower = true,
	upgradeCapacity = true,
}

local function send(player, kind, message, position)
	local payload = { kind = kind, message = message }
	if position then
		payload.position = position
	end
	feedbackRemote:FireClient(player, payload)
end

local function mirror(player, state)
	for key, value in pairs(state) do
		player:SetAttribute(key, value)
	end
end

local function setNodeVisual(nodeId, remaining)
	local node = authored.nodes[nodeId]
	if not node then
		return
	end
	local available = remaining &gt; 0
	node:SetAttribute(&quot;Remaining&quot;, remaining)
	node:SetAttribute(&quot;Available&quot;, available)
	if not originalNodeColors[nodeId] then
		originalNodeColors[nodeId] = node.Color
	end
	node.Color = available and originalNodeColors[nodeId] or Color3.fromRGB(45, 48, 60)
	for _, child in ipairs(node:GetChildren()) do
		if child:IsA(&quot;BasePart&quot;) then
			child.Transparency = available and 0 or 0.72
		end
	end
end

local function refill(nodeId)
	local data = nodeState[nodeId]
	if not data then
		return
	end
	data.remaining = Contract.NODE_CAPACITY
	data.refillPending = false
	setNodeVisual(nodeId, data.remaining)
end

local function depleteNode(nodeId)
	local data = nodeState[nodeId]
	if not data or data.refillPending then
		return
	end
	data.refillPending = true
	setNodeVisual(nodeId, 0)
	task.delay(Contract.NODE_RESPAWN, function()
		refill(nodeId)
	end)
end

for nodeId in pairs(authored.nodes) do
	nodeState[nodeId] = { remaining = Contract.NODE_CAPACITY, refillPending = false }
	setNodeVisual(nodeId, Contract.NODE_CAPACITY)
end

local function characterRoot(player)
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	local rootPart = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if not humanoid or humanoid.Health &lt;= 0 or not rootPart then
		return nil
	end
	return rootPart
end

local function initialize(player)
	if states[player] then
		return
	end
	states[player] = Economy.newState()
	cooldowns[player] = { general = 0, harvest = 0 }
	mirror(player, states[player])
end

local function removePlayer(player)
	states[player] = nil
	cooldowns[player] = nil
end

local function process(player, action, nodeId, argumentCount)
	if argumentCount &gt; 2 or type(action) ~= &quot;string&quot; or not validActions[action] then
		send(player, &quot;error&quot;, &quot;That action is not available.&quot;)
		return
	end

	if action == &quot;harvest&quot; then
		if argumentCount ~= 2 or type(nodeId) ~= &quot;string&quot; or not authored.nodes[nodeId] then
			send(player, &quot;error&quot;, &quot;Choose a known crystal node.&quot;)
			return
		end
	else
		if argumentCount ~= 1 or nodeId ~= nil then
			send(player, &quot;error&quot;, &quot;That action needs no node.&quot;)
			return
		end
	end

	local state = states[player]
	local timers = cooldowns[player]
	local rootPart = characterRoot(player)
	if not state or not timers or not rootPart then
		send(player, &quot;error&quot;, &quot;You must be alive to do that.&quot;)
		return
	end

	local now = os.clock()
	if now - timers.general &lt; Contract.ACTION_COOLDOWN then
		return
	end
	if action == &quot;harvest&quot; and now - timers.harvest &lt; Contract.HARVEST_COOLDOWN then
		send(player, &quot;error&quot;, &quot;Your pick is still recovering.&quot;)
		return
	end

	local target = action == &quot;harvest&quot; and authored.nodes[nodeId]
		or action == &quot;sell&quot; and authored.sell
		or authored.upgrades

	if (rootPart.Position - target.Position).Magnitude &gt; Contract.INTERACT_DISTANCE then
		send(player, &quot;error&quot;, &quot;You are too far away.&quot;)
		return
	end

	if action == &quot;harvest&quot; and state.Carry &gt;= state.Capacity then
		send(player, &quot;error&quot;, &quot;Your bag is full. Sell your crystals first.&quot;)
		return
	end

	local remaining = action == &quot;harvest&quot; and nodeState[nodeId].remaining or nil
	local beforeGoal = state.GoalComplete
	local outcome = Economy.apply(state, action, remaining)
	if not outcome.ok then
		send(player, &quot;error&quot;, outcome.message)
		return
	end

	timers.general = now
	if action == &quot;harvest&quot; then
		timers.harvest = now
		nodeState[nodeId].remaining -= outcome.amount
		setNodeVisual(nodeId, nodeState[nodeId].remaining)
		if nodeState[nodeId].remaining &lt;= 0 then
			depleteNode(nodeId)
		end
		mirror(player, state)
		send(player, &quot;harvest&quot;, outcome.message, target.Position)
	elseif action == &quot;sell&quot; then
		mirror(player, state)
		send(player, &quot;sell&quot;, outcome.message)
	else
		mirror(player, state)
		send(player, &quot;upgrade&quot;, outcome.message)
	end

	if not beforeGoal and state.GoalComplete then
		send(player, &quot;goal&quot;, &quot;Crystal Hollow restored! Your beacon shines for you.&quot;)
	end
end

actionRemote.OnServerEvent:Connect(function(player, ...)
	local argumentCount = select(&quot;#&quot;, ...)
	local action, nodeId = ...
	process(player, action, nodeId, argumentCount)
end)

Players.PlayerAdded:Connect(initialize)
Players.PlayerRemoving:Connect(removePlayer)
for _, player in ipairs(Players:GetPlayers()) do
	initialize(player)
end</ProtectedString></Properties></Item></Item></Item><Item class="ServerStorage" referent="RBX207"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX208"><Properties><string name="Name">Forge_GenerationPilot</string></Properties></Item></Item><Item class="StarterGui" referent="RBX209"><Properties><string name="Name">StarterGui</string></Properties><Item class="Folder" referent="RBX210"><Properties><string name="Name">Forge_GenerationPilot</string></Properties></Item></Item><Item class="StarterPlayer" referent="RBX211"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX212"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX213"><Properties><string name="Name">Forge_GenerationPilot</string></Properties><Item class="ModuleScript" referent="RBX214"><Properties><string name="Name">HUD</string><ProtectedString name="Source">local HUD = {}

local PANEL_COLOR = Color3.fromRGB(18, 25, 38)
local PANEL_ALT = Color3.fromRGB(28, 38, 56)
local TEXT = Color3.fromRGB(236, 246, 255)
local MUTED = Color3.fromRGB(166, 188, 208)
local CYAN = Color3.fromRGB(70, 225, 245)
local AMBER = Color3.fromRGB(255, 185, 78)
local VIOLET = Color3.fromRGB(169, 125, 255)

local function make(className, name, parent, properties)
	local object = Instance.new(className)
	object.Name = name
	object.Parent = parent
	for property, value in pairs(properties or {}) do
		object[property] = value
	end
	return object
end

local function label(parent, name, text, size, color, properties)
	local values = {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = color or TEXT,
		Font = Enum.Font.Gotham,
		TextSize = size or 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	for property, value in pairs(properties or {}) do
		values[property] = value
	end
	return make(&quot;TextLabel&quot;, name, parent, values)
end

local function button(parent, name, text, color)
	local item = make(&quot;TextButton&quot;, name, parent, {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Text = text,
		TextColor3 = TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		Active = true,
		Selectable = true,
	})
	make(&quot;UICorner&quot;, &quot;Corner&quot;, item, {CornerRadius = UDim.new(0, 7)})
	make(&quot;UIStroke&quot;, &quot;Outline&quot;, item, {Color = Color3.fromRGB(95, 116, 142), Thickness = 1, Transparency = 0.25})
	return item
end

function HUD.mount(playerGui)
	assert(playerGui, &quot;HUD.mount requires a PlayerGui&quot;)
	local previous = playerGui:FindFirstChild(&quot;CrystalHollowHUD&quot;)
	if previous then
		previous:Destroy()
	end

	local gui = make(&quot;ScreenGui&quot;, &quot;CrystalHollowHUD&quot;, playerGui, {
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})

	local main = make(&quot;Frame&quot;, &quot;MainPanel&quot;, gui, {
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, 12, 0, 12),
		Size = UDim2.new(0, 340, 0, 282),
		BackgroundColor3 = PANEL_COLOR,
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
	})
	make(&quot;UICorner&quot;, &quot;Corner&quot;, main, {CornerRadius = UDim.new(0, 12)})
	make(&quot;UIStroke&quot;, &quot;Outline&quot;, main, {Color = Color3.fromRGB(78, 130, 157), Thickness = 1, Transparency = 0.15})
	make(&quot;UIPadding&quot;, &quot;Padding&quot;, main, {
		PaddingTop = UDim.new(0, 11),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 13),
		PaddingRight = UDim.new(0, 13),
	})

	label(main, &quot;Title&quot;, &quot;CRYSTAL HOLLOW&quot;, 20, CYAN, {
		Size = UDim2.new(1, 0, 0, 27),
		Font = Enum.Font.GothamBlack,
	})
	label(main, &quot;Subtitle&quot;, &quot;Quarry loop  •  restore the beacon&quot;, 11, MUTED, {
		Position = UDim2.new(0, 0, 0, 27),
		Size = UDim2.new(1, 0, 0, 18),
	})

	local statsRow = make(&quot;Frame&quot;, &quot;StatsRow&quot;, main, {
		Position = UDim2.new(0, 0, 0, 50),
		Size = UDim2.new(1, 0, 0, 31),
		BackgroundTransparency = 1,
	})
	local carryLabel = label(statsRow, &quot;CarryLabel&quot;, &quot;Bag  0 / 8&quot;, 16, TEXT, {
		Size = UDim2.new(0.52, 0, 1, 0),
		Font = Enum.Font.GothamBold,
	})
	local coinsLabel = label(statsRow, &quot;CoinsLabel&quot;, &quot;Coins  0&quot;, 16, AMBER, {
		Position = UDim2.new(0.52, 0, 0, 0),
		Size = UDim2.new(0.48, 0, 1, 0),
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local tracks = make(&quot;Frame&quot;, &quot;UpgradeTracks&quot;, main, {
		Position = UDim2.new(0, 0, 0, 84),
		Size = UDim2.new(1, 0, 0, 47),
		BackgroundColor3 = PANEL_ALT,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
	})
	make(&quot;UICorner&quot;, &quot;Corner&quot;, tracks, {CornerRadius = UDim.new(0, 7)})
	local powerInfo = label(tracks, &quot;PowerInfo&quot;, &quot;PICK  Lv 1  •  Yield 1&quot;, 11, VIOLET, {
		Position = UDim2.new(0, 8, 0, 3), Size = UDim2.new(0.5, -10, 0, 20), Font = Enum.Font.GothamBold,
	})
	local bagInfo = label(tracks, &quot;BagInfo&quot;, &quot;BAG  Lv 1  •  Holds 8&quot;, 11, CYAN, {
		Position = UDim2.new(0.5, 2, 0, 3), Size = UDim2.new(0.5, -10, 0, 20), Font = Enum.Font.GothamBold,
	})
	local powerNext = label(tracks, &quot;PowerNext&quot;, &quot;Next: yield 2  •  40 coins&quot;, 10, MUTED, {
		Position = UDim2.new(0, 8, 0, 23), Size = UDim2.new(0.5, -10, 0, 18),
	})
	local bagNext = label(tracks, &quot;BagNext&quot;, &quot;Next: 14 slots  •  30 coins&quot;, 10, MUTED, {
		Position = UDim2.new(0.5, 2, 0, 23), Size = UDim2.new(0.5, -10, 0, 18),
	})

	local goalLabel = label(main, &quot;GoalLabel&quot;, &quot;Beacon goal  •  Sold 0 / 40  •  Pick 0/1  •  Bag 0/1&quot;, 11, TEXT, {
		Position = UDim2.new(0, 0, 0, 137), Size = UDim2.new(1, 0, 0, 20), Font = Enum.Font.GothamMedium,
	})
	local hint = label(main, &quot;Hint&quot;, &quot;Find a glowing crystal cluster nearby.&quot;, 11, MUTED, {
		Position = UDim2.new(0, 0, 0, 158), Size = UDim2.new(1, 0, 0, 23), TextXAlignment = Enum.TextXAlignment.Center,
	})

	local actions = make(&quot;Frame&quot;, &quot;Actions&quot;, main, {
		Position = UDim2.new(0, 0, 0, 185), Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1,
	})
	local harvestButton = button(actions, &quot;HarvestButton&quot;, &quot;E  HARVEST&quot;, Color3.fromRGB(24, 117, 132))
	harvestButton.Position = UDim2.new(0, 0, 0, 0); harvestButton.Size = UDim2.new(0.25, -4, 1, 0)
	local sellButton = button(actions, &quot;SellButton&quot;, &quot;Q  SELL&quot;, Color3.fromRGB(143, 82, 27))
	sellButton.Position = UDim2.new(0.25, 2, 0, 0); sellButton.Size = UDim2.new(0.25, -4, 1, 0)
	local powerButton = button(actions, &quot;PowerButton&quot;, &quot;1  PICK&quot;, Color3.fromRGB(77, 54, 132))
	powerButton.Position = UDim2.new(0.5, 2, 0, 0); powerButton.Size = UDim2.new(0.25, -4, 1, 0)
	local capacityButton = button(actions, &quot;CapacityButton&quot;, &quot;2  BAG&quot;, Color3.fromRGB(39, 91, 116))
	capacityButton.Position = UDim2.new(0.75, 2, 0, 0); capacityButton.Size = UDim2.new(0.25, -2, 1, 0)
	label(main, &quot;Footer&quot;, &quot;E/Q/1/2  or  tap a button&quot;, 10, MUTED, {
		Position = UDim2.new(0, 0, 0, 234), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center,
	})

	local toastMessage = nil
	local toastUntil = 0
	local toastPriority = nil
	local destroyed = false
	local handles = {
		gui = gui,
		harvestButton = harvestButton,
		sellButton = sellButton,
		powerButton = powerButton,
		capacityButton = capacityButton,
		coinsLabel = coinsLabel,
	}

	local function setButtonState(item, available)
		item.Active = true
		item.AutoButtonColor = available
		item.BackgroundTransparency = available and 0 or 0.42
		item.TextTransparency = available and 0 or 0.35
		local outline = item:FindFirstChild(&quot;Outline&quot;)
		if outline then outline.Transparency = available and 0.25 or 0.7 end
	end

	function handles.render(stats, context)
		if destroyed or not gui.Parent then return end
		stats = stats or {}; context = context or {}
		local carry = tonumber(stats.Carry) or 0
		local capacity = tonumber(stats.Capacity) or 8
		local coins = tonumber(stats.Coins) or 0
		local powerLevel = tonumber(stats.PowerLevel) or 0
		local capacityLevel = tonumber(stats.CapacityLevel) or 0
		local totalSold = tonumber(stats.TotalSold) or 0
		local goalComplete = stats.GoalComplete == true
		carryLabel.Text = string.format(&quot;Bag  %d / %d&quot;, carry, capacity)
		coinsLabel.Text = string.format(&quot;Coins  %d&quot;, coins)
		powerInfo.Text = string.format(&quot;PICK  Lv %d  •  Yield %d&quot;, powerLevel + 1, ({1, 2, 3})[powerLevel + 1] or 1)
		bagInfo.Text = string.format(&quot;BAG  Lv %d  •  Holds %d&quot;, capacityLevel + 1, capacity)
		if powerLevel &gt;= 2 then
			powerNext.Text = &quot;MAX LEVEL  •  Yield 3&quot;; powerButton.Text = &quot;1  PICK MAX&quot;
		else
			powerNext.Text = string.format(&quot;Next: yield %d  •  %d coins&quot;, ({1, 2, 3})[powerLevel + 2], ({40, 100})[powerLevel + 1])
			powerButton.Text = string.format(&quot;1  PICK  %d&quot;, ({40, 100})[powerLevel + 1])
		end
		if capacityLevel &gt;= 2 then
			bagNext.Text = &quot;MAX LEVEL  •  Holds 20&quot;; capacityButton.Text = &quot;2  BAG MAX&quot;
		else
			bagNext.Text = string.format(&quot;Next: %d slots  •  %d coins&quot;, ({8, 14, 20})[capacityLevel + 2], ({30, 80})[capacityLevel + 1])
			capacityButton.Text = string.format(&quot;2  BAG  %d&quot;, ({30, 80})[capacityLevel + 1])
		end
		goalLabel.Text = goalComplete and &quot;Beacon restored  •  Goal complete!&quot; or string.format(&quot;Beacon goal  •  Sold %d / 40  •  Pick %d/1  •  Bag %d/1&quot;, math.min(totalSold, 40), math.min(powerLevel, 1), math.min(capacityLevel, 1))
		goalLabel.TextColor3 = goalComplete and CYAN or TEXT
		local remaining = tonumber(context.nodeRemaining)
		local nearNode = context.nodeId ~= nil
		local nearSell = context.nearSell == true
		local nearUpgrades = context.nearUpgrades == true
		if toastMessage and os.clock() &lt; toastUntil then hint.Text = toastMessage
		elseif goalComplete then hint.Text = &quot;The beacon shines again. Keep quarrying!&quot;
		elseif nearNode and carry &gt;= capacity then hint.Text = &quot;Bag full — visit the amber SELL station.&quot;
		elseif nearNode and remaining == 0 then hint.Text = &quot;This node is dim. Try another crystal cluster.&quot;
		elseif nearNode then hint.Text = &quot;Crystal nearby — press E or tap HARVEST.&quot;
		elseif nearSell and carry &gt; 0 then hint.Text = &quot;Amber station ready — press Q or tap SELL.&quot;
		elseif nearUpgrades then hint.Text = &quot;Choose PICK for yield or BAG for capacity.&quot;
		else hint.Text = &quot;Follow the pale path to a glowing crystal cluster.&quot; end
		setButtonState(harvestButton, nearNode and remaining ~= 0 and carry &lt; capacity)
		setButtonState(sellButton, nearSell and carry &gt; 0)
		setButtonState(powerButton, nearUpgrades and powerLevel &lt; 2 and coins &gt;= (({40, 100})[powerLevel + 1] or math.huge))
		setButtonState(capacityButton, nearUpgrades and capacityLevel &lt; 2 and coins &gt;= (({30, 80})[capacityLevel + 1] or math.huge))
	end

	function handles.toast(message, priority)
		if destroyed or not gui.Parent then return end
		if toastPriority == &quot;goal&quot; and os.clock() &lt; toastUntil and priority ~= &quot;goal&quot; then return end
		toastPriority = priority
		toastMessage = tostring(message or &quot;&quot;)
		toastUntil = os.clock() + 3
		hint.Text = toastMessage; hint.TextColor3 = TEXT
	end

	function handles.destroy()
		if destroyed then return end
		destroyed = true
		if gui.Parent then gui:Destroy() end
	end

	return handles
end

return HUD</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX215"><Properties><string name="Name">Feedback</string><ProtectedString name="Source">local TweenService = game:GetService(&quot;TweenService&quot;)
local Debris = game:GetService(&quot;Debris&quot;)

local Feedback = {}
local effectFolder
local goalHighlight
local activeTweens = {}
local baseButtonColors = setmetatable({}, {__mode = &quot;k&quot;})

local function getFolder()
	if effectFolder and effectFolder.Parent then return effectFolder end
	local root = workspace:FindFirstChild(&quot;Forge_GenerationPilot&quot;)
	if not root then return nil end
	effectFolder = Instance.new(&quot;Folder&quot;)
	effectFolder.Name = &quot;LocalFeedbackEffects&quot;
	effectFolder.Parent = root
	return effectFolder
end

local function pulseButton(hud, buttonName, color)
	if not hud or not hud[buttonName] then return end
	local button = hud[buttonName]
	if not button.Parent then return end
	local original = baseButtonColors[button] or button.BackgroundColor3
	baseButtonColors[button] = original
	local existing = activeTweens[button]
	if existing then existing:Cancel() end
	button.BackgroundColor3 = color
	local tween = TweenService:Create(button, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = original})
	activeTweens[button] = tween
	tween:Play()
	tween.Completed:Connect(function()
		if activeTweens[button] == tween then activeTweens[button] = nil end
	end)
end

local function pulseCoins(hud)
	if not hud or not hud.coinsLabel or not hud.coinsLabel.Parent then return end
	local label = hud.coinsLabel
	local originalColor = label.TextColor3
	local originalSize = label.TextSize
	local existing = activeTweens[label]
	if existing then existing:Cancel() end
	label.TextColor3 = Color3.fromRGB(255, 236, 130)
	label.TextSize = originalSize + 4
	local tween = TweenService:Create(label, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextColor3 = originalColor, TextSize = originalSize})
	activeTweens[label] = tween
	tween:Play()
	tween.Completed:Connect(function()
		if activeTweens[label] == tween then activeTweens[label] = nil end
	end)
end

local function harvestSparkle(position)
	local folder = getFolder()
	if not folder or typeof(position) ~= &quot;Vector3&quot; then return end
	local orb = Instance.new(&quot;Part&quot;)
	orb.Name = &quot;HarvestSparkle&quot;
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(0.35, 0.35, 0.35)
	orb.CFrame = CFrame.new(position + Vector3.new(0, 2.2, 0))
	orb.Anchored = true; orb.CanCollide = false; orb.CanQuery = false
	orb.Material = Enum.Material.Neon; orb.Color = Color3.fromRGB(100, 235, 255); orb.Transparency = 0.1
	orb.Parent = folder
	local emitter = Instance.new(&quot;ParticleEmitter&quot;)
	emitter.Name = &quot;CrystalBurst&quot;
	emitter.Color = ColorSequence.new(Color3.fromRGB(85, 235, 255), Color3.fromRGB(174, 115, 255))
	emitter.LightEmission = 0.8; emitter.Lifetime = NumberRange.new(0.25, 0.55); emitter.Speed = NumberRange.new(2, 5)
	emitter.SpreadAngle = Vector2.new(360, 360); emitter.Rate = 0
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(0.7, 0.1), NumberSequenceKeypoint.new(1, 0)})
	emitter.Parent = orb; emitter:Emit(18)
	TweenService:Create(orb, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = Vector3.new(1.1, 1.1, 1.1), Transparency = 1, CFrame = orb.CFrame + Vector3.new(0, 1.1, 0)}):Play()
	Debris:AddItem(orb, 0.75)
end

local function ensureGoalGlow()
	if goalHighlight and goalHighlight.Parent then return end
	local root = workspace:FindFirstChild(&quot;Forge_GenerationPilot&quot;)
	local world = root and root:FindFirstChild(&quot;World&quot;)
	local beacon = world and world:FindFirstChild(&quot;Beacon&quot;)
	if not beacon then return end
	goalHighlight = Instance.new(&quot;Highlight&quot;)
	goalHighlight.Name = &quot;LocalBeaconGlow&quot;
	goalHighlight.Adornee = beacon
	goalHighlight.FillColor = Color3.fromRGB(80, 225, 255)
	goalHighlight.OutlineColor = Color3.fromRGB(190, 125, 255)
	goalHighlight.FillTransparency = 0.28; goalHighlight.OutlineTransparency = 0
	goalHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	goalHighlight.Parent = beacon
end

function Feedback.play(payload, hud)
	if type(payload) ~= &quot;table&quot; then return end
	local kind = payload.kind
	if kind == &quot;harvest&quot; then
		harvestSparkle(payload.position); pulseButton(hud, &quot;harvestButton&quot;, Color3.fromRGB(75, 190, 205))
	elseif kind == &quot;sell&quot; then
		pulseButton(hud, &quot;sellButton&quot;, Color3.fromRGB(255, 172, 58)); pulseCoins(hud)
	elseif kind == &quot;upgrade&quot; then
		local target = string.find(tostring(payload.message), &quot;Pick&quot;) and &quot;powerButton&quot; or &quot;capacityButton&quot;
		pulseButton(hud, target, Color3.fromRGB(151, 112, 245))
	elseif kind == &quot;goal&quot; then
		ensureGoalGlow()
		if not payload.steady and hud then hud.toast(payload.message, &quot;goal&quot;) end
		return
	end
	if hud and payload.message then hud.toast(payload.message) end
end

function Feedback.destroy()
	for object, tween in pairs(activeTweens) do
		tween:Cancel(); activeTweens[object] = nil
	end
	if effectFolder then effectFolder:Destroy(); effectFolder = nil end
	if goalHighlight then goalHighlight:Destroy(); goalHighlight = nil end
end

return Feedback</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX216"><Properties><string name="Name">Controller</string><ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)
local scriptFolder = script.Parent
local HUD = require(scriptFolder:WaitForChild(&quot;HUD&quot;))
local Feedback = require(scriptFolder:WaitForChild(&quot;Feedback&quot;))
local shared = ReplicatedStorage:WaitForChild(&quot;Forge_GenerationPilot&quot;)
local Contract = require(shared:WaitForChild(&quot;Contract&quot;))
local actionRemote = shared:WaitForChild(&quot;Action&quot;)
local feedbackRemote = shared:WaitForChild(&quot;Feedback&quot;)
local worldRoot = workspace:WaitForChild(&quot;Forge_GenerationPilot&quot;):WaitForChild(&quot;World&quot;)
local nodesFolder = worldRoot:WaitForChild(&quot;Nodes&quot;)
local hud = HUD.mount(playerGui)
local connections = {}
local characterConnection
local destroyed = false
local goalCelebrated = false

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function snapshot()
	return {
		Carry = player:GetAttribute(&quot;Carry&quot;), Coins = player:GetAttribute(&quot;Coins&quot;),
		PowerLevel = player:GetAttribute(&quot;PowerLevel&quot;), CapacityLevel = player:GetAttribute(&quot;CapacityLevel&quot;),
		Capacity = player:GetAttribute(&quot;Capacity&quot;), TotalSold = player:GetAttribute(&quot;TotalSold&quot;),
		GoalComplete = player:GetAttribute(&quot;GoalComplete&quot;),
	}
end

local function getRootPart()
	local character = player.Character
	if not character then return nil end
	local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	local rootPart = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if not humanoid or humanoid.Health &lt;= 0 or not rootPart then return nil end
	return rootPart
end

local function nearestNode(rootPart)
	if not rootPart then return nil, nil end
	local nearestId, nearestDistance = nil, math.huge
	for index = 1, 6 do
		local id = string.format(&quot;Node%02d&quot;, index)
		local node = nodesFolder:FindFirstChild(id)
		if node then
			local distance = (rootPart.Position - node.Position).Magnitude
			if distance &lt; nearestDistance then nearestDistance = distance; nearestId = id end
		end
	end
	if nearestDistance &lt;= Contract.INTERACT_DISTANCE then
		local node = nodesFolder:FindFirstChild(nearestId)
		return nearestId, node and (node:GetAttribute(&quot;Remaining&quot;) or Contract.NODE_CAPACITY) or nil
	end
	return nil, nil
end

local function refresh()
	if destroyed then return end
	local rootPart = getRootPart()
	local nodeId, nodeRemaining = nearestNode(rootPart)
	local nearSell, nearUpgrades = false, false
	if rootPart then
		nearSell = (rootPart.Position - worldRoot:WaitForChild(&quot;SellStation&quot;).Position).Magnitude &lt;= Contract.INTERACT_DISTANCE
		nearUpgrades = (rootPart.Position - worldRoot:WaitForChild(&quot;UpgradeStation&quot;).Position).Magnitude &lt;= Contract.INTERACT_DISTANCE
	end
	hud.render(snapshot(), {nodeId = nodeId, nodeRemaining = nodeRemaining, nearSell = nearSell, nearUpgrades = nearUpgrades})
end

local function request(action)
	if destroyed then return end
	if action == &quot;harvest&quot; then
		local nodeId = nearestNode(getRootPart())
		if nodeId then actionRemote:FireServer(&quot;harvest&quot;, nodeId) else hud.toast(&quot;Move closer to a glowing crystal cluster.&quot;) end
	elseif action == &quot;sell&quot; then actionRemote:FireServer(&quot;sell&quot;)
	elseif action == &quot;upgradePower&quot; then actionRemote:FireServer(&quot;upgradePower&quot;)
	elseif action == &quot;upgradeCapacity&quot; then actionRemote:FireServer(&quot;upgradeCapacity&quot;) end
end

local function onInput(input, gameProcessed)
	if gameProcessed or UserInputService:GetFocusedTextBox() then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard or input.UserInputState ~= Enum.UserInputState.Begin then return end
	if input.KeyCode == Enum.KeyCode.E then request(&quot;harvest&quot;)
	elseif input.KeyCode == Enum.KeyCode.Q then request(&quot;sell&quot;)
	elseif input.KeyCode == Enum.KeyCode.One then request(&quot;upgradePower&quot;)
	elseif input.KeyCode == Enum.KeyCode.Two then request(&quot;upgradeCapacity&quot;) end
end

connect(UserInputService.InputBegan, onInput)
connect(hud.harvestButton.Activated, function() request(&quot;harvest&quot;) end)
connect(hud.sellButton.Activated, function() request(&quot;sell&quot;) end)
connect(hud.powerButton.Activated, function() request(&quot;upgradePower&quot;) end)
connect(hud.capacityButton.Activated, function() request(&quot;upgradeCapacity&quot;) end)
connect(feedbackRemote.OnClientEvent, function(payload)
	if type(payload) == &quot;table&quot; and payload.kind == &quot;goal&quot; then
		if goalCelebrated then
			payload = {kind = &quot;goal&quot;, steady = true}
		else
			goalCelebrated = true
		end
	end
	Feedback.play(payload, hud)
	refresh()
end)

for _, attributeName in ipairs({&quot;Carry&quot;, &quot;Coins&quot;, &quot;PowerLevel&quot;, &quot;CapacityLevel&quot;, &quot;Capacity&quot;, &quot;TotalSold&quot;, &quot;GoalComplete&quot;}) do
	connect(player:GetAttributeChangedSignal(attributeName), function()
		if attributeName == &quot;GoalComplete&quot; and player:GetAttribute(&quot;GoalComplete&quot;) == true then
			if not goalCelebrated then
				goalCelebrated = true
				Feedback.play({kind = &quot;goal&quot;, message = &quot;Crystal Hollow restored! Your beacon shines for you.&quot;}, hud)
			else
				Feedback.play({kind = &quot;goal&quot;, steady = true}, hud)
			end
		end
		refresh()
	end)
end

connect(RunService.Heartbeat, refresh)
characterConnection = player.CharacterAdded:Connect(function()
	task.defer(function()
		if destroyed then return end
		refresh()
		if player:GetAttribute(&quot;GoalComplete&quot;) == true then Feedback.play({kind = &quot;goal&quot;, steady = true}, hud) end
	end)
end)

task.defer(function()
	refresh()
	if player:GetAttribute(&quot;GoalComplete&quot;) == true then
		goalCelebrated = true
		Feedback.play({kind = &quot;goal&quot;, steady = true}, hud)
	end
end)

script.Destroying:Connect(function()
	if destroyed then return end
	destroyed = true
	for _, connection in ipairs(connections) do connection:Disconnect() end
	if characterConnection then characterConnection:Disconnect() end
	Feedback.destroy()
	hud.destroy()
end)</ProtectedString></Properties></Item></Item></Item></Item></roblox>