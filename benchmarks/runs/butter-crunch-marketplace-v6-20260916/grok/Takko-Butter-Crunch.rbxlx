d">true</bool><bool name="CanCollide">true</bool></Properties></Item><Item class="Part" referent="RBX9"><Properties><string name="Name">Butter</string><Vector3 name="Size"><X>1.4</X><Y>0.6</Y><Z>2.2</Z></Vector3><Vector3 name="Position"><X>0</X><Y>4.2</Y><Z>0</Z></Vector3><Color3 name="Color"><R>1</R><G>0.9</G><B>0.25</B></Color3><bool name="Anchored">true</bool><bool name="CanCollide">true</bool></Properties><Item class="ClickDetector" referent="RBX10"><Properties><string name="Name">ClickDetector</string><double name="MaxActivationDistance">50</double></Properties></Item></Item><Item class="SpawnLocation" referent="RBX11"><Properties><string name="Name">SpawnLocation</string><CoordinateFrame name="CFrame"><X>0</X><Y>0.5</Y><Z>-6</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><Vector3 name="Size"><X>4</X><Y>1</Y><Z>4</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><Color3 name="Color"><R>0.75</R><G>0.75</G><B>0.75</B></Color3><bool name="Enabled">true</bool></Properties></Item><Item class="Part" referent="RBX12"><Properties><string name="Name">LightHolder</string><Vector3 name="Size"><X>0.2</X><Y>0.2</Y><Z>0.2</Z></Vector3><Vector3 name="Position"><X>0</X><Y>7</Y><Z>0</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><double name="Transparency">1</double></Properties><Item class="PointLight" referent="RBX13"><Properties><string name="Name">PointLight</string><double name="Range">40</double><double name="Brightness">2</double><Color3 name="Color"><R>1</R><G>0.95</G><B>0.8</B></Color3></Properties></Item></Item><Item class="IntValue" referent="RBX14"><Properties><string name="Name">CrunchCount</string><double name="Value">0</double></Properties></Item></Item></Item></Item><Item class="ReplicatedStorage" referent="RBX15"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX16"><Properties><string name="Name">Forge_98c63e12b73c</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX17"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX18"><Properties><string name="Name">Forge_98c63e12b73c</string></Properties><Item class="Script" referent="RBX19"><Properties><string name="Name">CrunchServer</string><ProtectedString name="Source">local TweenService = game:GetService(&quot;TweenService&quot;)
local Players = game:GetService(&quot;Players&quot;)

local NAMESPACE = &quot;Forge_98c63e12b73c&quot;

local root = workspace:WaitForChild(NAMESPACE)
local world = root:WaitForChild(&quot;World&quot;)
local butter = world:WaitForChild(&quot;Butter&quot;)
local clickDetector = butter:WaitForChild(&quot;ClickDetector&quot;)
local assets = root:WaitForChild(&quot;Assets&quot;)
local crunchSound = assets:WaitForChild(&quot;crunchAudio&quot;)
local crunchCount = world:WaitForChild(&quot;CrunchCount&quot;)

crunchSound.Parent = butter
crunchSound.Volume = 0.75

local originalSize = butter.Size
local originalPos = butter.Position

local isCrunching = false
local lastCrunchTime = {}
local COOLDOWN = 1.5

local function performCrunch(player: Player)
	if isCrunching then
		return
	end

	local now = os.clock()
	local lastTime = lastCrunchTime[player.UserId] or 0
	if now - lastTime &lt; COOLDOWN then
		return
	end

	-- Validate character and distance
	local character = player.Character
	if not character then
		return
	end
	local hrp = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if not hrp then
		return
	end
	local distance = (hrp.Position - butter.Position).Magnitude
	if distance &gt; 15 then
		return
	end

	lastCrunchTime[player.UserId] = now
	isCrunching = true

	-- Increment counter
	crunchCount.Value = crunchCount.Value + 1

	-- Play sound
	crunchSound:Play()

	-- Squash animation
	local squashSize = Vector3.new(1.9, 0.28, 2.7)
	local squashY = 3.9 + 0.14
	local squashPos = Vector3.new(0, squashY, 0)

	local squashTween = TweenService:Create(butter, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = squashSize,
		Position = squashPos
	})
	squashTween:Play()

	task.wait(0.18)

	-- Recover animation
	local recoverTween = TweenService:Create(butter, TweenInfo.new(0.75, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
		Size = originalSize,
		Position = originalPos
	})
	recoverTween:Play()

	task.wait(0.75)

	isCrunching = false
end

clickDetector.MouseClick:Connect(performCrunch)

Players.PlayerRemoving:Connect(function(player)
	lastCrunchTime[player.UserId] = nil
end)</ProtectedString></Properties></Item></Item></Item><Item class="ServerStorage" referent="RBX20"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX21"><Properties><string name="Name">Forge_98c63e12b73c</string></Properties></Item></Item><Item class="StarterGui" referent="RBX22"><Properties><string name="Name">StarterGui</string></Properties><Item class="Folder" referent="RBX23"><Properties><string name="Name">Forge_98c63e12b73c</string></Properties><Item class="ScreenGui" referent="RBX24"><Properties><string name="Name">CrunchScreenGui</string><bool name="ResetOnSpawn">false</bool><bool name="Enabled">true</bool></Properties><Item class="Frame" referent="RBX25"><Properties><string name="Name">CounterFrame</string><UDim2 name="Size"><XS>0.25</XS><XO>0</XO><YS>0.12</YS><YO>0</YO></UDim2><UDim2 name="Position"><XS>0.375</XS><XO>0</XO><YS>0.03</YS><YO>0</YO></UDim2><Color3 name="BackgroundColor3"><R>0.16</R><G>0.16</G><B>0.16</B></Color3><double name="BackgroundTransparency">0.3</double><double name="BorderSizePixel">0</double></Properties><Item class="TextLabel" referent="RBX26"><Properties><string name="Name">CounterLabel</string><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><double name="BackgroundTransparency">1</double><string name="Text">0</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">false</bool><double name="TextSize">48</double><token name="Font">2</token><double name="TextStrokeTransparency">0.5</double><Color3 name="TextStrokeColor3"><R>0</R><G>0</G><B>0</B></Color3></Properties></Item></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX27"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX28"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX29"><Properties><string name="Name">Forge_98c63e12b73c</string></Properties><Item class="LocalScript" referent="RBX30"><Properties><string name="Name">CrunchClient</string><ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)

local player = Players.LocalPlayer
local root = workspace:WaitForChild(&quot;Forge_98c63e12b73c&quot;)
local world = root:WaitForChild(&quot;World&quot;)
local butter = world:WaitForChild(&quot;Butter&quot;)
local crunchCount = world:WaitForChild(&quot;CrunchCount&quot;)

local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)
local guiFolder = playerGui:WaitForChild(&quot;Forge_98c63e12b73c&quot;)
local screenGui = guiFolder:WaitForChild(&quot;CrunchScreenGui&quot;)
local counterFrame = screenGui:WaitForChild(&quot;CounterFrame&quot;)
local counterLabel = counterFrame:WaitForChild(&quot;CounterLabel&quot;)

local function updateCounter()
	counterLabel.Text = tostring(crunchCount.Value)
	local popTween = TweenService:Create(counterLabel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextSize = 60})
	popTween:Play()
	popTween.Completed:Connect(function()
		local resetTween = TweenService:Create(counterLabel, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextSize = 48})
		resetTween:Play()
	end)
end

crunchCount.Changed:Connect(updateCounter)
updateCounter()

local originalSize = butter.Size
local originalPos = butter.Position

local function playLocalAnimation()
	local squashSize = Vector3.new(1.9, 0.28, 2.7)
	local squashY = 3.9 + 0.14
	local squashPos = Vector3.new(0, squashY, 0)
	local squashTween = TweenService:Create(butter, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = squashSize,
		Position = squashPos
	})
	squashTween:Play()
	task.wait(0.18)
	local recoverTween = TweenService:Create(butter, TweenInfo.new(0.75, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
		Size = originalSize,
		Position = originalPos
	})
	recoverTween:Play()
end

local lastCount = crunchCount.Value
crunchCount.Changed:Connect(function(newValue)
	if newValue &gt; lastCount then
		playLocalAnimation()
	end
	lastCount = newValue
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		-- ClickDetector handles server trigger for desktop and mobile taps/clicks
	end
end)</ProtectedString></Properties></Item></Item></Item></Item></roblox>