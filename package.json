{
  "name": "takko-studio",
  "version": "0.2.0",
  "description": "Local multi-model Roblox generation with guided specifications and a Studio bridge",
  "scripts": {
    "benchmark": "tsx scripts/benchmark-quality.ts",
    "test": "vitest run",
    "dev": "tsx src/server/start.ts",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "test:luau": "node scripts/test-luau.mjs",
    "check": "npm test && npm run test:luau && npm run test:plugin && npm run test:guards && npm run build && npm run test:desktop && npm run test:production && npm run test:e2e",
    "sample": "tsx scripts/export-sample.ts",
    "test:guards": "node scripts/evaluate-guards.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "test:plugin": "node scripts/test-plugin.mjs",
    "audio:build": "node scripts/build-audio-capture.mjs",
    "desktop:build": "npm run build && tsc --noEmit --project desktop/tsconfig.json && node desktop/build.mjs",
    "desktop": "npm run desktop:build && electron dist-desktop",
    "desktop:package": "npm run desktop:build && node desktop/package.mjs",
    "test:desktop": "tsc --noEmit --project desktop/tsconfig.json && node desktop/build.mjs && node --test desktop/tests/*.test.mjs",
    "test:desktop:native": "electron desktop/tests/electron-smoke.mjs"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "^5.11.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "private": true
}
